# ==============================================================
# EditorConfig: keeps formatting consistent across editors/IDEs.
# https://editorconfig.org
# ==============================================================
root = true

# ---- Defaults for all files ----
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# ---- C/C++ sources and headers ----
[*.{c,cc,cpp,cxx,h,hh,hpp,hxx,ixx}]
indent_style = space
indent_size = 4
tab_width = 4

# ---- CMake ----
[{CMakeLists.txt,*.cmake}]
indent_style = space
indent_size = 2

# ---- Config/data formats ----
[*.{yml,yaml,json,toml}]
indent_style = space
indent_size = 2

# ---- Web/markup ----
[*.{html,htm,xml}]
indent_style = space
indent_size = 2

# ---- Shell scripts ----
[*.{sh,bash}]
indent_style = space
indent_size = 2

# ---- Dockerfiles ----
[Dockerfile]
indent_style = space
indent_size = 4

[*.dockerfile]
indent_style = space
indent_size = 4

# ---- Markdown: trailing spaces are meaningful (line breaks) ----
[*.md]
trim_trailing_whitespace = false
