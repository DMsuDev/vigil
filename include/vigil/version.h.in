#pragma once

#include <cstdint>
#include <string_view>

/**
 * @file version.h
 * @brief Vigil semantic version information (compile-time and runtime).
 *
 * Vigil follows Semantic Versioning (MAJOR.MINOR.PATCH):
 *  - MAJOR: breaking API changes.
 *  - MINOR: backwards-compatible features.
 *  - PATCH: backwards-compatible bug fixes.
 *
 * Two equivalent APIs are provided:
 *  - Preprocessor macros (`VIGIL_VERSION_*`), for use inside `#if` directives.
 *  - The `vigil::version` namespace, preferred everywhere else in C++ code.
 */

// ============================================================================
// GENERATED FILE - DO NOT EDIT.
// ----------------------------------------------------------------------------
// This header is generated by CMake via configure_file() from version.h.in.
// The version is defined exclusively in:
//
//     project(Vigil VERSION <MAJOR.MINOR.PATCH>)
//
// inside the project's root CMakeLists.txt. To bump the version, edit only
// that line; do not edit this generated file directly.
// ============================================================================

// ============================================================================
// Preprocessor API
// ============================================================================

/// @def VIGIL_VERSION_MAJOR
/// @brief Major version component (breaking changes).
#define VIGIL_VERSION_MAJOR @PROJECT_VERSION_MAJOR@

/// @def VIGIL_VERSION_MINOR
/// @brief Minor version component (backwards-compatible features).
#define VIGIL_VERSION_MINOR @PROJECT_VERSION_MINOR@

/// @def VIGIL_VERSION_PATCH
/// @brief Patch version component (backwards-compatible bug fixes).
#define VIGIL_VERSION_PATCH @PROJECT_VERSION_PATCH@

/// @def VIGIL_VERSION_STRING
/// @brief Human-readable version string, e.g. "1.2.3".
#define VIGIL_VERSION_STRING "@PROJECT_VERSION@"

/// @def VIGIL_VERSION_ENCODE(major, minor, patch)
/// @brief Packs a MAJOR.MINOR.PATCH triplet into a single comparable integer.
/// @details Encoding: major*10000 + minor*100 + patch (e.g. 1.2.3 -> 10203).
#define VIGIL_VERSION_ENCODE(major, minor, patch) \
    (((major) * 10000u) + ((minor) * 100u) + (patch))

/// @def VIGIL_VERSION
/// @brief The current Vigil version, packed via ::VIGIL_VERSION_ENCODE.
#define VIGIL_VERSION \
    VIGIL_VERSION_ENCODE( \
        VIGIL_VERSION_MAJOR, \
        VIGIL_VERSION_MINOR, \
        VIGIL_VERSION_PATCH)

/// @def VIGIL_VERSION_AT_LEAST(major, minor, patch)
/// @brief Compile-time gate: true if the current version is >= the given one.
/// @par Example
/// @code
/// #if VIGIL_VERSION_AT_LEAST(1, 2, 0)
///     // ...
/// #endif
/// @endcode
#define VIGIL_VERSION_AT_LEAST(major, minor, patch) \
    (VIGIL_VERSION >= VIGIL_VERSION_ENCODE((major), (minor), (patch)))

// ============================================================================
// Modern C++ API
// ============================================================================

namespace vigil::version {

/// @brief Major version component (breaking changes).
inline constexpr std::uint32_t major = VIGIL_VERSION_MAJOR;

/// @brief Minor version component (backwards-compatible features).
inline constexpr std::uint32_t minor = VIGIL_VERSION_MINOR;

/// @brief Patch version component (backwards-compatible bug fixes).
inline constexpr std::uint32_t patch = VIGIL_VERSION_PATCH;

/// @brief Packed version number (e.g. 1.2.3 -> 10203).
inline constexpr std::uint32_t value = VIGIL_VERSION;

/// @brief Human-readable version string (e.g. "1.2.3").
inline constexpr std::string_view string = VIGIL_VERSION_STRING;

/**
 * @brief Encodes a semantic version triplet into Vigil's packed integer format.
 * @param major Major version component.
 * @param minor Minor version component.
 * @param patch Patch version component.
 * @return Packed integer: major*10000 + minor*100 + patch.
 *
 * @par Example
 * @code
 * encode(1, 2, 3) == 10203;
 * @endcode
 */
[[nodiscard]] constexpr std::uint32_t encode(
    std::uint32_t major_version,
    std::uint32_t minor_version,
    std::uint32_t patch_version) noexcept
{
    return VIGIL_VERSION_ENCODE(major_version, minor_version, patch_version);
}

/**
 * @brief Checks whether the current Vigil version is >= the given version.
 * @param major Minimum required major version.
 * @param minor Minimum required minor version.
 * @param patch Minimum required patch version.
 * @return true if `value >= encode(major, minor, patch)`.
 *
 * @par Example
 * @code
 * if constexpr (vigil::version::at_least(1, 1, 0)) {
 *     // ...
 * }
 * @endcode
 */
[[nodiscard]] constexpr bool at_least(
    std::uint32_t major_version,
    std::uint32_t minor_version,
    std::uint32_t patch_version) noexcept
{
    return value >= encode(major_version, minor_version, patch_version);
}

} // namespace vigil::version
